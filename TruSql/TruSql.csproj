<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  
	  <!-- NuGet package metadata -->
	  <PackageId>TruSql</PackageId>
	  <Version>1.0.0</Version>
	  <Description>TruSql is a SQL query builder for dynamically constructing and validating queries at runtime.</Description>
	  <PackageOutputPath>./package</PackageOutputPath>
	  <Authors>Indra</Authors>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
	<None Include="README.md" Pack="true" PackagePath="\" />
	<InternalsVisibleTo Include="TruSql.Test" />
	<InternalsVisibleTo Include="TruSqlShowcase" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TruSql.Core\TruSql.Core.csproj" />
  </ItemGroup>
</Project>
